# =============================================================================
# .dev.env — local development environment bootstrap configuration
#
# Copy to .dev.env (gitignored) and fill in. Consumed by ./dev-up.sh.
# Only the PROD_DB_* values ever touch a production system (read-only pg_dump);
# everything else is local.
# =============================================================================

# --- Production database (READ ONLY — used once per boot to clone data) ------
# host:port of the production postgres server.
PROD_DB_HOST_PORT=
PROD_DB_USER=
PROD_DB_PASSWORD=
# Space-separated database names to clone.
PROD_DB_NAMES="app bot ponder"
# Set to 1 (or pass --skip-db-clone) to reuse previously cloned local databases.
SKIP_DB_CLONE=0

# --- Local postgres -----------------------------------------------------------
# Assumes a local postgres reachable at localhost:5432 with trust/peer auth.
LOCAL_DB_USER=postgres
LOCAL_DB_HOST_PORT=localhost:5432
# Only needed if your local postgres requires a password (trust auth ignores it).
LOCAL_DB_PASSWORD=

# --- Celo fork (anvil) --------------------------------------------------------
# Public Celo RPC to fork from (never written to).
CELO_FORK_RPC_URL=https://forno.celo.org
# Optional: pin the fork block for reproducibility (empty = latest).
ANVIL_FORK_BLOCK=

# --- Citizen Wallet engine ----------------------------------------------------
ENGINE_REPO=https://github.com/citizenwallet/engine.git
ENGINE_BRANCH=main
# Extra flags appended to the engine start command (e.g. "-polling").
ENGINE_EXTRA_FLAGS=

# --- Ponder -------------------------------------------------------------------
# Optional: override the indexing start block (defaults to the value baked into
# ponder.config.ts). Set to the fork block for faster local (re)indexing.
PONDER_START_BLOCK=

# --- Backend ------------------------------------------------------------------
# Privy verification (same values as backend/.env; auth SaaS, not SFLUV prod).
PRIVY_APP_ID=
PRIVY_VKEY=
# Shared admin key used between backend <-> ponder locally (any dev value).
DEV_ADMIN_KEY=local-dev-admin-key
DEV_PONDER_KEY=local-dev-ponder-key

# --- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_ID=

# --- Webpage (public marketing site) ------------------------------------------
# Path to the webpage repo. Defaults to ../webpage beside this repo; boot skips
# the webpage with a notice if it isn't there.
# WEBPAGE_DIR=/absolute/path/to/webpage
# Where the free-port search starts. The webpage claims the first UNUSED port
# from here up rather than evicting whatever holds a fixed port.
# WEBPAGE_PORT_BASE=3002

# --- Mobile app (Expo) --------------------------------------------------------
MOBILE_APP_REPO=https://github.com/SFLuv/mobile-app.git
# Branch to pull — change to test feature branches.
MOBILE_APP_BRANCH=main
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAP_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=
# LAN IP of this machine so Expo Go on a real device can reach the local
# backend (empty = localhost, fine for simulators).
DEV_LAN_IP=

# --- Volunteer events ---------------------------------------------------------
# Externally reachable origin of THIS backend. Volunteer event cover photos and
# organizer logos are emitted as absolute URLs built from it. If unset the URLs
# fall back to root-relative, which resolves for same-origin callers but 404s on
# the marketing site — the server logs a warning at boot when it is missing.
PUBLIC_BACKEND_URL=http://localhost:8080
# Shared secret with the sfluv.org signup proxy. When a request presents this in
# the X-SFLUV-Proxy-Key header, its X-Forwarded-For is trusted for per-IP rate
# limiting; otherwise the socket IP is used. Vercel has no stable egress IPs, so
# this replaces an IP allowlist. Must never be exposed to a browser bundle.
VOLUNTEER_PROXY_KEY=
# Gates the volunteer tab/portal on clients via /config. Absent or not "true"
# means disabled, so an old client build never lights up a tab that would 404.
VOLUNTEER_EVENTS_ENABLED=true
