# =============================================================================
# .dev.env — local development environment bootstrap configuration
#
# Copy to .dev.env (gitignored) and fill in. Consumed by ./dev-up.sh.
# Only the PROD_DB_* values ever touch a production system (read-only pg_dump);
# everything else is local.
# =============================================================================

# --- Production database (READ ONLY — used once per boot to clone data) ------
# host:port of the production postgres server.
PROD_DB_HOST_PORT=
PROD_DB_USER=
PROD_DB_PASSWORD=
# Space-separated databases to clone. Each entry is either "name" (same name
# locally) or "prod_name:local_name" when prod calls it something else. The
# local name is what the services actually read, so map it rather than renaming
# by hand — e.g. if the Celo indexer database is migration_celo_ponder on prod:
#   PROD_DB_NAMES="app bot migration_celo_ponder:ponder"
PROD_DB_NAMES="app bot ponder"
# Set to 1 (or pass --skip-db-clone) to reuse previously cloned local databases.
SKIP_DB_CLONE=0

# --- Local postgres -----------------------------------------------------------
# Assumes a local postgres reachable at localhost:5432 with trust/peer auth.
# Leave LOCAL_DB_USER empty to auto-detect: Homebrew's postgres creates a
# superuser named after your OS user and NO "postgres" role, so hard-coding
# "postgres" fails on a stock Mac install with `role "postgres" does not exist`.
# (`psql postgres` still works there — that opens the database named postgres
# over a socket as your OS user, which is a different thing entirely.) Set it
# explicitly only to pin a specific role.
LOCAL_DB_USER=
LOCAL_DB_HOST_PORT=localhost:5432
# Only needed if your local postgres requires a password (trust auth ignores it).
LOCAL_DB_PASSWORD=
# Local database names the services read. Change these only alongside the
# local half of PROD_DB_NAMES above.
APP_DB_NAME=app
BOT_DB_NAME=bot
PONDER_DB_NAME=ponder
ENGINE_DB_NAME=cw_engine
# pg_dump refuses to read a server newer than itself, and Homebrew's
# postgresql@15 shadows newer clients on PATH. Left empty, dev-up picks the
# highest-versioned pg_dump/pg_restore it can find (including libpq's). Set
# these to pin a specific binary.
PG_DUMP_BIN=
PG_RESTORE_BIN=

# --- Celo fork (anvil) --------------------------------------------------------
# Public Celo RPC to fork from (never written to).
CELO_FORK_RPC_URL=https://forno.celo.org
# Optional: pin the fork block for reproducibility (empty = latest).
ANVIL_FORK_BLOCK=

# --- Citizen Wallet engine ----------------------------------------------------
ENGINE_REPO=https://github.com/citizenwallet/engine.git
ENGINE_BRANCH=main
# Extra flags appended to the engine start command (e.g. "-polling").
ENGINE_EXTRA_FLAGS=

# --- Ponder -------------------------------------------------------------------
# Optional: override the indexing start block (defaults to the value baked into
# ponder.config.ts). Set to the fork block for faster local (re)indexing.
PONDER_START_BLOCK=

# --- Backend ------------------------------------------------------------------
# Privy verification (same values as backend/.env; auth SaaS, not SFLUV prod).
PRIVY_APP_ID=
PRIVY_VKEY=
# Shared admin key used between backend <-> ponder locally (any dev value).
DEV_ADMIN_KEY=local-dev-admin-key
DEV_PONDER_KEY=local-dev-ponder-key
# Server-side Google Places key, used to re-verify a merchant's Google listing
# before storing it. Leave empty to reuse NEXT_PUBLIC_GOOGLE_MAPS_API_KEY below;
# that works as long as the key is not HTTP-referrer restricted. Empty overall
# is safe — verification is skipped and local validation still applies.
GOOGLE_MAPS_SERVER_API_KEY=

# --- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_ID=

# --- Webpage (public marketing site) ------------------------------------------
# Path to the webpage repo. Defaults to ../webpage beside this repo; boot skips
# the webpage with a notice if it isn't there.
# WEBPAGE_DIR=/absolute/path/to/webpage
# Where the free-port search starts. The webpage claims the first UNUSED port
# from here up rather than evicting whatever holds a fixed port.
# WEBPAGE_PORT_BASE=3002

# --- Mobile app (Expo) --------------------------------------------------------
MOBILE_APP_REPO=https://github.com/SFLuv/mobile-app.git
# Branch to pull — change to test feature branches.
MOBILE_APP_BRANCH=main
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAP_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=
# LAN IP of this machine so Expo Go on a real device can reach the local
# backend (empty = localhost, fine for simulators).
DEV_LAN_IP=

# --- Volunteer events ---------------------------------------------------------
# Externally reachable origin of THIS backend. Volunteer event cover photos and
# organizer logos are emitted as absolute URLs built from it. If unset the URLs
# fall back to root-relative, which renders blank in React Native and 404s
# against sfluv.org in a browser. dev-up sets this automatically from the port
# the backend actually bound, so it is listed here for reference only.
# PUBLIC_BACKEND_URL=http://localhost:8080
# Shared secret with the sfluv.org signup proxy. When a request presents this in
# the X-SFLUV-Proxy-Key header, its X-Forwarded-For is trusted for per-IP rate
# limiting; otherwise the socket IP is used. Vercel has no stable egress IPs, so
# this replaces an IP allowlist. Must never be exposed to a browser bundle.
VOLUNTEER_PROXY_KEY=
# Gates the volunteer tab/portal on clients via /config. Absent or not "true"
# means disabled, so an old client build never lights up a tab that would 404.
# dev-up defaults this to true so the tab is exercisable locally.
VOLUNTEER_EVENTS_ENABLED=true
# Public base URL of the volunteer portal (the marketing site), used to build the
# signup-confirmation link emailed to anonymous portal signups. dev-up sets this
# automatically from the port the webpage actually claimed, so it only needs
# setting if you run the webpage yourself.
# VOLUNTEER_PORTAL_BASE_URL=
# How often the maintenance sweep runs: workflow payout reconciliation and
# finalization, recurring volunteer event generation, code minting after a
# faucet top-up, due event reminders, and expiry of unconfirmed signup holds.
# Go duration string; empty uses the backend default of 5m. Shorten it to watch
# recurrence or reminders fire without waiting.
# WORKFLOW_MAINTENANCE_INTERVAL=1m
