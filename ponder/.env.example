# Mainnet RPC URL used for fetching blockchain data. Alchemy is recommended.
PONDER_RPC_URL_1=https://rpc.berachain.com

# (Optional) Postgres database URL. If not provided, SQLite will be used.
DATABASE_URL=postgresql://postgres:@localhost:5432/ponder

# Auth. Every API route requires it in the X-Admin-Key header, and it is sent
# with every hook ping and notification. Unset refuses every API request.
ADMIN_KEY=x

# (Optional) Origins a hook URL may point at, comma-separated — the origin of the
# backend's PONDER_CALLBACK_URL, e.g. https://api.sfluv.org. Unset allows any
# origin, and says so at boot. When set, stored hooks outside it are named at boot.
HOOK_ALLOWED_ORIGINS=

# W9
PAID_ADMIN_ADDRESSES=
W9_TRANSACTION_URL=
