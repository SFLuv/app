*/.env
*/.env.test
*/.env.local
# Hand-made backups of env files hold the same secrets as the originals.
.env.bak
*/.env.bak
**/*.env.bak
**/.env.*.bak
*/go.sum
*/package-lock.json
**.db
.next
node_modules
.DS_Store
pnpm-lock.yaml
ponder/generated
backend/backend
backend/builds-old
.idea
tmp/
.dev.env
# Any sibling of .dev.env too — a backup of it holds every credential in the
# stack, including the read-only production database password. Enumerated
# suffixes are not enough: a file named .dev.env.bak-privy matched none of the
# .env.bak patterns above and sat untracked in the worktree, one `git add -A`
# away from being committed.
.dev.env.*
!.dev.env.example

# Playwright end-to-end harness. Tracked separately; not part of the app.
# The e2e suite is tracked — it is the most valuable test layer and being
# gitignored made it invisible in git status, absent from a fresh clone, and
# rebuilt from scratch twice by people who could not see it. Only the seeded
# session is excluded: it is a live credential.
/e2e/node_modules/
/e2e/.auth/
/e2e/test-results/
/e2e/playwright-report/

# Ponder codegen output at the repo root.
/generated/
