#SERVER
PORT=8080
IN_PRODUCTION=false
APP_BASE_URL=http://localhost:3000
# Optional explicit browser allowlist for API CORS. Falls back to APP_BASE_URL,
# plus localhost defaults when IN_PRODUCTION=false.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

#DATABASE
DB_TYPE=x
DB_BASE_URL= # falls back to DB_URL, then localhost:5432
APP_DB_NAME=app
BOT_DB_NAME=bot
# Ponder (transfers/history/W9) database name. Point this at the dedicated Celo
# Ponder DB (the cross-chain continuity ledger) post-migration.
PONDER_DB_NAME=ponder
DB_USER= # only needed for postgres
DB_PASSWORD= # only needed for postgres

#AUTH
ADMIN_KEY=x

#CHAIN
# Client blockchain config is loaded at backend boot from Citizen Wallet config.
# The backend fetches the whole community config from the communities API at
# ${CITIZEN_WALLET_COMMUNITY_API_URL}/${CITIZEN_WALLET_COMMUNITY_ALIAS} and uses
# the config embedded in the response's "json" field.
# If remote config is unavailable, CLIENT_CONFIG_FALLBACK_PATH is read.
# If neither source is available, the backend fails to boot.
# Set CLIENT_CONFIG_LOCAL_ONLY=true to skip Citizen Wallet entirely and load
# CLIENT_CONFIG_FALLBACK_PATH directly for local fork/migration testing.
#
# Alias must be exact. Note both of these SFLuv communities exist:
#   wallet.berachain.sfluv.org -> "SFLUV Community" (Berachain, chain 80094)
#   wallet.sfluv.org           -> "SFLUV Community (Polygon)"
CITIZEN_WALLET_COMMUNITY_ALIAS=wallet.berachain.sfluv.org
# Optional overrides:
# CITIZEN_WALLET_COMMUNITY_API_URL=  # communities API base (default https://my.citizenwallet.xyz/api/communities)
# CITIZEN_WALLET_CONFIG_URL=         # full URL to a single raw-config file; bypasses the communities API when set
CLIENT_CONFIG_LOCAL_ONLY=false
CLIENT_CONFIG_FALLBACK_PATH=community-config.json

# Legacy env values still used by transitional scripts/ops. Runtime client-facing
# blockchain values should come from the boot-loaded Citizen Wallet config.
TOKEN_ID=x
UNDERLYING_TOKEN_ID=x
# Legacy backend token multiplier used for payouts, W9 limits, and formatting.
# /config derives ERC-20 decimal places from this value for the mobile app.
# Multiplier from whole SFLUV to base units, i.e. 10^decimals — NOT the decimal
# count. $SFLUV has 6 decimals, so this is 1000000. (A stale 1e18 here inflates
# every amount by a factor of a trillion.) dev-up derives it from the community
# config automatically.
TOKEN_DECIMALS=1000000
# Full JSON-RPC node URL. Also served to clients as /config.extras.rpc_url and
# used by web/mobile for READS (eth_getCode/eth_getBalance/eth_getStorageAt),
# which the Citizen Wallet engine does not support. The AA bundler/paymaster
# still uses the engine (chains[].node.url/v1/rpc/{paymaster}). Must be a real
# node, not the engine. CLIENT_READ_RPC_URL overrides this for the served value.
RPC_URL=x

# Chain-specific extras that Citizen Wallet config does not model yet. These are
# added under /config.extras at backend boot and should be left empty on chains
# where the integration is unavailable. If BYUSD/HONEY are present in the
# Citizen Wallet tokens map, that config remains authoritative and these token
# extras are omitted from the served payload.
BACKING_ASSETS=
HONEY_ADDRESS=
HONEY_DECIMALS=
BYUSD_ADDRESS=
BYUSD_DECIMALS=
ZAPPER_ADDRESS=
FAUCET_ADDRESS=
BOT_KEY=x
BOT_ADDRESS=x
ADMIN_ADDRESS=x
REDEEMER_ADMIN_KEY=x
REDEEMER_ADMIN_ADDRESS=x

#PRIVY
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VKEY=""
PRIVY_API_BASE_URL=https://auth.privy.io/api/v1

#MAILGUN
MAILGUN_API_KEY=x
MAILGUN_DOMAIN=mail.sfluv.org
# Set NOTIFICATION_TEST_MODE=true to disable Mailgun/Expo sends and write
# rendered notifications under backend/test-notifications by default.
NOTIFICATION_TEST_MODE=false
NOTIFICATION_TEST_OUTPUT_DIR=
AFFILIATE_ADMIN_EMAIL=admin@sfluv.org
PROPOSER_ADMIN_EMAIL=admin@sfluv.org
IMPROVER_ADMIN_EMAIL=admin@sfluv.org
WORKFLOW_ADMIN_EMAIL=admin@sfluv.org

#WORKFLOW
# Stored workflow photo upload byte limit. Multipart request limit is 2x this value.
WORKFLOW_PHOTO_UPLOAD_MAX_BYTES=4194304

#PONDER
PONDER_SERVER_BASE_URL=http://localhost:42069
PONDER_KEY=x
# On boot the backend compares the webhooks our database expects against the
# ones Ponder actually holds, and reports any drift. Set to "true" to also
# recreate hooks for active push subscriptions whose hook has gone missing.
# Off by default: recreation calls out to Ponder, so it is a deliberate choice.
# The check refuses to repair when Ponder reports zero hooks while active
# references exist — that pattern is usually a misconfiguration, not real loss.
PONDER_HOOK_AUTO_REPAIR=false
PONDER_CALLBACK_URL=http://localhost:8080/ponder/callback

# ADMIN MCP (read-only admin data over MCP, gated by Privy admin login via OAuth)
# Public base URL of THIS backend (OAuth issuer / endpoint URLs). Falls back to
# PUBLIC_BACKEND_URL if unset.
MCP_PUBLIC_BASE_URL=http://localhost:8080
# Frontend page that performs the Privy login step. Defaults to
# ${APP_BASE_URL}/mcp/authorize; only override if the frontend lives elsewhere.
MCP_AUTHORIZE_URL=http://localhost:3000/mcp/authorize

# MOBILE CLIENT CONFIG + VERSION POLICY
PUBLIC_BACKEND_URL=http://localhost:8080
CLIENT_CONFIG_VERSION=local
CLIENT_MIN_VERSION=1.0.0
# Update link served to clients flagged for update. The platform-specific value
# (CLIENT_UPDATE_URL_<PLATFORM>) is preferred based on the request's platform,
# falling back to CLIENT_UPDATE_URL for web/unknown clients. Point the generic
# fallback at the /update landing page, which offers both store links.
CLIENT_UPDATE_URL=https://app.sfluv.org/update
CLIENT_UPDATE_URL_IOS=https://apps.apple.com/us/app/sfluv/id6762672190
CLIENT_UPDATE_URL_ANDROID=https://play.google.com/store/apps/details?id=org.sfluv.wallet
CLIENT_UPDATE_REQUIRED_MESSAGE=An SFLUV Wallet update is required.
CLIENT_MAINTENANCE=false
CLIENT_MAINTENANCE_MESSAGE=SFLUV is temporarily unavailable while maintenance is in progress.
CLIENT_DYNAMIC_CONFIG_REQUIRED=true
CLIENT_CELO_REQUIRED=false
CLIENT_COMMUNITY_NAME=SFLUV Community
CLIENT_COMMUNITY_ALIAS=wallet.berachain.sfluv.org
CLIENT_COMMUNITY_CUSTOM_DOMAIN=wallet.sfluv.org
CLIENT_COMMUNITY_LOGO=https://assets.citizenwallet.xyz/wallet-config/_images/sfluv.svg
CLIENT_COMMUNITY_PROFILE_ADDRESS=0x05e2Fb34b4548990F96B3ba422eA3EF49D5dAa99
CHAIN_ID=80094
CHAIN_NAME=Berachain
NATIVE_CURRENCY_NAME=BERA
NATIVE_CURRENCY_SYMBOL=BERA
NATIVE_CURRENCY_DECIMALS=18
TOKEN_NAME=SFLUV
TOKEN_SYMBOL=SFLUV
ENGINE_RPC_URL=https://80094.engine.citizenwallet.xyz
ENGINE_WS_URL=wss://80094.engine.citizenwallet.xyz
EXPLORER_NAME=Berascan
EXPLORER_URL=https://berascan.com
# Do not set CITIZEN_WALLET_CONFIG_URL to a per-community ${alias}.json file on
# this host: those return HTTP 403, and "wallet.sfluv.org" is the Polygon
# community, not Berachain. Config is loaded via the communities API + alias above.
IPFS_URL=https://ipfs.internal.citizenwallet.xyz
FEATURE_SENDS_ENABLED=true
FEATURE_REDEMPTIONS_ENABLED=true
FEATURE_WORKFLOW_PAYOUTS_ENABLED=true
FEATURE_MERCHANT_PAYMENTS_ENABLED=true

# W-9 compliance
PAID_ADMIN_ADDRESSES=
# Which provider mints and tracks W-9 forms. "fake" serves a local stub form
# and needs no credentials — the right choice for most dev work. "taxbandits"
# drives the real vendor and needs the credential block below plus a publicly
# reachable webhook URL (see W9_PROVIDER_WEBHOOK_REF further down).
W9_PROVIDER=fake
# sandbox | production — selects the TaxBandits host pair. The two consoles
# issue SEPARATE credential sets; sandbox credentials are rejected by the
# production hosts and vice versa.
W9_PROVIDER_ENV=sandbox
# TaxBandits console → Settings → API Credentials.
W9_PROVIDER_CLIENT_ID=
W9_PROVIDER_CLIENT_SECRET=
W9_PROVIDER_USER_TOKEN=
W9_PROVIDER_BUSINESS_ID=
# true | false. true withholds at the tiers; false computes every decision and
# pays anyway — useful for watching the tiers without holding money, and the
# reason a W-9 gate can look broken while working exactly as configured. False
# is the safe default: deploying cannot start withholding on its own.
W9_ENFORCEMENT=true
# The escalating tiers, in whole SFLUV. Defaults 400 / 500 / 600: polite notice,
# firmer warning, then the crossing payment is escrowed and everything after it
# is refused until a W-9 clears.
# W9_TIER_NOTICE_SFLUV=400
# W9_TIER_WARNING_SFLUV=500
# W9_THRESHOLD_SFLUV=600
# Optional TLS (local HTTPS)
# TLS_CERT_FILE=/path/to/localhost.crt
# TLS_KEY_FILE=/path/to/localhost.key
# TLS_PORT=8443

# GOOGLE PLACES
# Server-side key used to re-verify merchant locations against Google Places
# (New) before storing them. Falls back to GOOGLE_MAPS_API_KEY, then to
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. If none is set, verification is skipped and
# only local validation applies. Must NOT be HTTP-referrer restricted.
GOOGLE_MAPS_SERVER_API_KEY=

# VOLUNTEER EVENTS
# Gates the volunteer portal on the mobile app and marketing site via /config.
# Absent or not "true" means disabled, so an old client build never lights up a
# tab pointing at endpoints this backend does not serve yet.
VOLUNTEER_EVENTS_ENABLED=true
# Gates every unwrap affordance (SFLUV -> backing asset) on clients via /config.
# Absent or not exactly "true" means off, and it must stay off until the wallet
# doing the unwrap holds REDEEMER_ROLE on the token: the flag alone only reveals
# the button, the on-chain grant is what makes it work.
# UNWRAP_ENABLED=false
# Shared secret with the sfluv.org signup proxy. sfluv.org proxies signups
# server-side, so without this every web signup shares one rate-limit bucket;
# with it, X-Forwarded-For is trusted (only) from callers presenting the key in
# X-SFLUV-Proxy-Key. This replaces an IP allowlist because Vercel has no stable
# egress IPs. Must be set to the SAME value in the webpage project's env, and
# must never be exposed to a browser bundle.
VOLUNTEER_PROXY_KEY=
# Public base URL of the volunteer portal (the marketing site), used to build
# the signup-confirmation link emailed to anonymous portal signups. Falls back
# to APP_BASE_URL when unset.
VOLUNTEER_PORTAL_BASE_URL=http://localhost:3002
# How often the maintenance sweep runs: workflow payout reconciliation and
# finalization, recurring volunteer event generation, code minting after a
# faucet top-up, due event reminders, and expiry of unconfirmed signup holds.
# Go duration string; empty uses the built-in default of 5m.
WORKFLOW_MAINTENANCE_INTERVAL=

# MERCHANT ONBOARDING GATE
# Holds a merchant account that has not listed a shop yet to reads: it can open
# the app and look at the map, and every POST/PUT/PATCH/DELETE outside the
# onboarding submission and the way out of the app is refused with 403 and
# X-SFLUV-Auth-Reason: merchant-onboarding-required.
# On unless set to false. This is the rollback: the predicate decides who may
# write, so if it is ever wrong about somebody the fix has to be a restart, not
# a deploy.
# MERCHANT_ONBOARDING_GATE_ENABLED=true

# MERCHANT FAUCET BAR
# Refuses POST /redeem when the scanned address resolves to a merchant-typed
# account. Merchants take payment, they do not draw from the faucet: a shop
# owner who also wants to volunteer signs up a second, regular account.
# On unless set to false. It decides who gets paid, so a wrong call has to be
# revocable with a restart rather than a deploy.
# MERCHANT_FAUCET_BAR_ENABLED=true

# LOCATION TILLS
# Mints a location's payment and tipping wallets when the merchant submits the
# form, so the Locations tab has an address to show while approval is pending.
# It also stops a first location inheriting the owner's personal wallet: every
# location created from now on gets a till of its own.
# On unless set to false. It decides which address a shop's takings land at, so
# a wrong call has to be revocable with a restart rather than a deploy. Turned
# off, approval mints the till exactly as it used to.
# LOCATION_WALLET_MINT_ON_CREATE=true

# Grants REDEEMER_ROLE on chain to every wallet attached to a location, once per
# server start, in the background. Skips anything already holding the role, so a
# converged estate sends no transactions at all. Needs the same
# REDEEMER_ADMIN_KEY / REDEEMER_ADMIN_ADDRESS pair and IN_PRODUCTION=true as the
# rest of the redeemer service.
# On unless set to false. It decides who can turn tokens back into money.
# REDEEMER_LOCATION_WALLET_SYNC=true


# Routes this environment's callbacks to ONE of the URLs registered in the
# TaxBandits console (up to five). Optional, and worth setting the moment more
# than one environment exists: without it every registered URL receives every
# status change, so a sandbox callback about somebody's money can land in
# production, or a production one on a laptop's tunnel.
W9_PROVIDER_WEBHOOK_REF=

# Where the vendor sends somebody after they submit the form. Defaults to
# ${PUBLIC_BACKEND_URL}/w9/complete, which the backend serves itself.
#
# Must NOT be the app's URL scheme: the vendor requires an https URL, and the
# form runs in the system browser. The page this serves hands people back to
# the app itself — an auto-raised "Open in SFLuv?" prompt plus a button — so
# nothing upstream needs to know how the return trip works.
W9_RETURN_URL=
